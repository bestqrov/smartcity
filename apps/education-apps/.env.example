# Database
# DATABASE_URL="postgresql://username:password@localhost:5432/school_management?schema=public"
DATABASE_URL="mongodb+srv://username:password@your-cluster.mongodb.net/your-db?retryWrites=true&w=majority"
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV=Production


# JWT
# JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
# JWT_EXPIRES_IN=7d


# Web Push (parent notifications) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.com

# Optional school WhatsApp through an Evolution API server (leave empty to disable)
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# Notification outbox worker (push + WhatsApp sender). Set to 0 on extra instances so only one runs it.
OUTBOX_WORKER=1
