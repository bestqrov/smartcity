// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SECRETARY
  OWNER
  SUPER_ADMIN
  SALES_AGENT
}

enum SchoolStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum PayoutMethod {
  BANK_TRANSFER
  MONEY_TRANSFER
  MOBILE_MONEY
  CASH
}

enum SubscriptionPeriod {
  MONTHLY
  SEMIANNUAL
  YEARLY
}

enum InscriptionType {
  SOUTIEN
  FORMATION
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  JUSTIFIED // absent with a valid excuse (medical note, family reason...) — not counted against the student
}

enum AttendanceSource {
  SCAN // student's QR card scanned at the door
  MANUAL // set by staff from the weekly attendance grid
  AUTO // absence sweep: nobody scanned before the session ended
}

enum NotificationChannel {
  WHATSAPP
  SMS
  PUSH
}

enum NotificationStatus {
  SENT
  FAILED
}

model User {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  email         String   @unique
  password      String
  role          UserRole
  name          String
  avatar        String? // Base64 encoded image or URL
  gsm           String?
  whatsapp      String?
  address       String?
  schoolLevel   String?
  certification String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  schoolId String? @db.ObjectId
  school   School? @relation(fields: [schoolId], references: [id])
  branchId String? @db.ObjectId
  branch   Branch? @relation(fields: [branchId], references: [id])
  salesAgent SalesAgent?

  @@map("users")
}

model Parent {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  phone           String
  whatsapp        String?
  email           String?
  cin             String?
  address         String?
  accessTokenHash String   @unique
  // When the current access link was created or re-issued; null for parents created by an import (no link handed out yet).
  linkIssuedAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  students      Student[]
  notifications AttendanceNotification[]

  // The branch (school site) this parent belongs to: only that branch's staff can see,
  // edit or re-issue the parent's access link. Null only on parents created before
  // scoping that had no child to infer it from — invisible to everyone until fixed.
  branchId String? @db.ObjectId
  branch   Branch? @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@map("parents")
}

model School {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  status      SchoolStatus @default(PENDING)
  ownerName   String
  ownerEmail  String
  ownerPhone  String?
  director    String?
  city        String?
  address     String?
  phone       String?
  email       String?
  logo        String?
  trialEndsAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  branches Branch[]
  users    User[]

  institutionType InstitutionType? // null is treated as PRIVATE_SCHOOL
  packId          String?          @db.ObjectId
  pack            Pack?            @relation(fields: [packId], references: [id])
  salesAgentId String?          @db.ObjectId
  salesAgent   SalesAgent?      @relation(fields: [salesAgentId], references: [id])
  payments     SchoolPayment[]
  packUpgrades PackUpgrade[]

  // Partner offer taken at signup through a partner's referral link: period and price are frozen then.
  partnerOffer Boolean             @default(false)
  offerPeriod  SubscriptionPeriod?
  offerPrice   Float?

  @@index([packId])
  @@index([salesAgentId])
  @@map("schools")
}

model Branch {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String   @db.ObjectId
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  city      String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                   User[]
  students                Student[]
  parents                 Parent[]
  groups                  Group[]
  teachers                Teacher[]
  inscriptions            Inscription[]
  payments                Payment[]
  transactions            Transaction[]
  pricing                 Pricing[]
  attendances             Attendance[]
  attendanceNotifications AttendanceNotification[]
  formations              Formation[]
  settings                Settings[]
  announcements           Announcement[]
  holidays                Holiday[]
  vehicles                Vehicle[]
  drivers                 Driver[]
  transportRoutes         TransportRoute[]
  transportStops          TransportStop[]
  transportSubscriptions  TransportSubscription[]

  @@map("branches")
}

model Student {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  surname          String
  phone            String?
  email            String?
  cin              String?
  address          String?
  birthDate        DateTime?
  birthPlace       String?
  fatherName       String?
  motherName       String?
  parentName       String?
  parentPhone      String?
  parentRelation   String?
  schoolLevel      String?
  currentSchool    String?
  crecheSection    String? // NOURRISSON | MOYENNE | GRANDE — crèche only
  healthNotes      String? // allergies / health notes — crèche only
  authorizedPickup Json? // [{ name, phone, relation }] — crèche only
  massarNumber     String? // set only when crecheSection = GRANDE
  subjects         Json?
  photo            String? // Base64 encoded image or file path
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  parentId        String? @db.ObjectId
  parent          Parent? @relation(fields: [parentId], references: [id])
  accessTokenHash String  @unique // Attendance QR — scanned by staff, not shared with the student
  portalTokenHash String? @unique // Student's own passwordless profile link (like Parent.accessTokenHash) — separate from the attendance token above

  branchId String @db.ObjectId
  branch   Branch @relation(fields: [branchId], references: [id])

  inscriptions           Inscription[]
  payments               Payment[]
  attendances            Attendance[]
  transportSubscriptions TransportSubscription[]

  groupIds String[] @db.ObjectId
  groups   Group[]  @relation(fields: [groupIds], references: [id])

  @@map("students")
}

model Group {
  id   String          @id @default(auto()) @map("_id") @db.ObjectId
  name String
  type InscriptionType @default(SOUTIEN)

  // Soutien fields
  level   String? // e.g. LYCEE
  subject String? // e.g. MATHS

  // Formation fields
  formationId String?    @db.ObjectId
  formation   Formation? @relation(fields: [formationId], references: [id])

  room        String?
  whatsappUrl String?

  teacherId String?  @db.ObjectId
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  studentIds String[]  @db.ObjectId
  students   Student[] @relation(fields: [studentIds], references: [id])

  attendances Attendance[]

  timeSlots Json? // [{ day: string, startTime: string, endTime: string }]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchId String @db.ObjectId
  branch   Branch @relation(fields: [branchId], references: [id])

  @@map("groups")
}

model Teacher {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  email       String?
  phone       String?
  cin         String?
  dob         DateTime?
  gender      String?
  picture     String?
  status      String    @default("Active")
  socialMedia Json? // { linkedin, twitter, facebook, whatsapp }

  hourlyRate  Float  @default(0)
  paymentType String @default("HOURLY") // HOURLY, FIXED, PERCENTAGE
  commission  Float? // For percentage based payment

  specialties String[] // Subjects
  levels      String[] // Levels

  // Teacher portal (/t/<token>): only the hash of the secret link is stored.
  // Not @unique: MongoDB's non-sparse unique index rejects many teachers without a link (null dup keys);
  // a 256-bit token hash is unique in practice, lookups use findFirst.
  accessTokenHash String?
  linkIssuedAt    DateTime?

  groups Group[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchId String @db.ObjectId
  branch   Branch @relation(fields: [branchId], references: [id])

  @@index([accessTokenHash])
  @@map("teachers")
}

model Inscription {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  studentId String          @db.ObjectId
  student   Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type      InscriptionType
  category  String
  amount    Float
  date      DateTime        @default(now())
  note      String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  branchId String @db.ObjectId
  branch   Branch @relation(fields: [branchId], references: [id])

  @@map("inscriptions")
}

model Payment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  studentId String   @db.ObjectId
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amount    Float
  method    String
  note      String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transportSubscriptionId String?                @db.ObjectId
  transportSubscription   TransportSubscription? @relation(fields: [transportSubscriptionId], references: [id])
  forMonth                String? // "YYYY-MM", only set on transport payments

  branchId String @db.ObjectId
  branch   Branch @relation(fields: [branchId], references: [id])

  @@index([transportSubscriptionId, forMonth])
  @@map("payments")
}

model Attendance {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  studentId  String           @db.ObjectId
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId    String?          @db.ObjectId
  group      Group?           @relation(fields: [groupId], references: [id])
  date       DateTime
  // "HH:MM" start of the group's session this record is for — a group can meet several
  // times the same day (schools), so (student, group, date) alone is not one session.
  // Null on records created before sessions were tracked.
  slotStart  String?
  scannedAt  DateTime?
  status     AttendanceStatus
  source     AttendanceSource @default(MANUAL)
  note       String?
  markedById String?          @db.ObjectId
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  notifications AttendanceNotification[]

  branchId String @db.ObjectId
  branch   Branch @relation(fields: [branchId], references: [id])

  @@unique([studentId, groupId, date, slotStart])
  @@index([groupId, date])
  @@map("attendances")
}

model AttendanceNotification {
  id           String              @id @default(auto()) @map("_id") @db.ObjectId
  attendanceId String              @db.ObjectId
  attendance   Attendance          @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  parentId     String              @db.ObjectId
  parent       Parent              @relation(fields: [parentId], references: [id])
  channel      NotificationChannel
  message      String
  status       NotificationStatus
  sentAt       DateTime            @default(now())

  branchId String @db.ObjectId
  branch   Branch @relation(fields: [branchId], references: [id])

  @@map("attendance_notifications")
}

model AccessLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  parentId   String?  @db.ObjectId
  studentId  String?  @db.ObjectId
  ip         String?
  accessedAt DateTime @default(now())

  @@map("access_logs")
}

model Settings {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolName   String
  logo         String?
  academicYear String
  contactInfo  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transportPricingMode  TransportPricingMode? // null is treated as ROUTE
  transportUniformPrice Float?

  gradingPeriods String[] // empty = defaults ["Semestre 1", "Semestre 2"]

  branchId String @db.ObjectId
  branch   Branch @relation(fields: [branchId], references: [id])

  @@unique([branchId])
  @@map("settings")
}

model Formation {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  duration    String
  price       Float
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  groups Group[]

  branchId String @db.ObjectId
  branch   Branch @relation(fields: [branchId], references: [id])

  @@map("formations")
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Transaction {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  type        TransactionType
  amount      Float
  category    String
  description String?
  date        DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  branchId String @db.ObjectId
  branch   Branch @relation(fields: [branchId], references: [id])

  @@map("transactions")
}

model Announcement {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  body      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchId String @db.ObjectId
  branch   Branch @relation(fields: [branchId], references: [id])

  @@map("announcements")
}

model Holiday {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  startDate DateTime
  endDate   DateTime
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchId String @db.ObjectId
  branch   Branch @relation(fields: [branchId], references: [id])

  @@map("holidays")
}

model Pricing {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  category    String // SOUTIEN, FORMATION
  level       String // LYCÉE, COLLÈGE, etc.
  subject     String // MATHS, PHYSIQUE, etc.
  price       Float    @default(0)
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branchId String @db.ObjectId
  branch   Branch @relation(fields: [branchId], references: [id])

  @@map("pricing")
}

enum TransportSubscriptionStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum TransportPricingMode {
  ROUTE
  STOP
  UNIFORM
}

model Vehicle {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  plate     String
  capacity  Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchId String @db.ObjectId
  branch   Branch @relation(fields: [branchId], references: [id])

  routes TransportRoute[]

  @@index([branchId])
  @@map("vehicles")
}

model Driver {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  phone     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchId String @db.ObjectId
  branch   Branch @relation(fields: [branchId], references: [id])

  routes TransportRoute[]

  @@index([branchId])
  @@map("drivers")
}

model TransportRoute {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  monthlyPrice Float?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vehicleId String  @db.ObjectId
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])
  driverId  String  @db.ObjectId
  driver    Driver  @relation(fields: [driverId], references: [id])

  branchId String @db.ObjectId
  branch   Branch @relation(fields: [branchId], references: [id])

  stops         TransportStop[]
  subscriptions TransportSubscription[]

  @@index([branchId])
  @@map("transport_routes")
}

model TransportStop {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  order         Int
  morningTime   String // "HH:mm"
  afternoonTime String // "HH:mm"
  monthlyPrice  Float?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  routeId String         @db.ObjectId
  route   TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  branchId String @db.ObjectId
  branch   Branch @relation(fields: [branchId], references: [id])

  subscriptions TransportSubscription[]

  @@index([routeId, order])
  @@map("transport_stops")
}

model TransportSubscription {
  id           String                      @id @default(auto()) @map("_id") @db.ObjectId
  monthlyPrice Float
  startDate    DateTime                    @default(now())
  endDate      DateTime?
  status       TransportSubscriptionStatus @default(ACTIVE)
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  studentId String         @db.ObjectId
  student   Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  routeId   String         @db.ObjectId
  route     TransportRoute @relation(fields: [routeId], references: [id])
  stopId    String         @db.ObjectId
  stop      TransportStop  @relation(fields: [stopId], references: [id])

  branchId String @db.ObjectId
  branch   Branch @relation(fields: [branchId], references: [id])

  payments Payment[]

  @@index([branchId, status])
  @@index([routeId, status])
  @@index([studentId])
  @@map("transport_subscriptions")
}

enum InstitutionType {
  PRIVATE_SCHOOL
  TUTORING_CENTER
  VOCATIONAL_TRAINING
  LANGUAGE_CENTER
  CRECHE
}

model Pack {
  id               String            @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  code             String            @unique
  monthlyPrice     Float
  yearlyPrice      Float
  maxStudents      Int?
  maxBranches      Int?
  features         String[]
  institutionTypes InstitutionType[]
  isDefault        Boolean           @default(false)
  active           Boolean           @default(true)
  sortOrder        Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  schools School[]

  @@index([active, sortOrder])
  @@map("packs")
}

// A commercial who brings schools in. The house agent (isHouse) is the company's own code used in its ads:
// it has no login (userId null). Only the house agent may have a null userId (MongoDB unique index).
model SalesAgent {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  phone          String?
  code           String          @unique
  // Percent 0-100 per payment period; packRates override them for one (pack, period).
  monthlyRate    Float
  semiannualRate Float
  yearlyRate     Float
  packRates      AgentPackRate[]
  isHouse        Boolean         @default(false)
  active         Boolean         @default(true)
  // How the agent wants to be paid, filled by the agent. Only the fields of the chosen method are set.
  payoutMethod   PayoutMethod?
  bankName       String?
  rib            String? // 24 digits, no spaces
  accountHolder  String?
  payoutPhone    String?
  walletProvider String? // INWI_MONEY | ORANGE_MONEY, validated in code; only for MOBILE_MONEY
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  userId String? @unique @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  schools  School[]
  payments SchoolPayment[]
  payouts  AgentPayout[]

  @@map("sales_agents")
}

// A sales agent's rate for one (pack, period), embedded in SalesAgent. (packId, period) is unique per agent.
type AgentPackRate {
  packId String             @db.ObjectId
  period SubscriptionPeriod
  rate   Float
}

// A subscription payment made by a school, recorded by the SUPER_ADMIN. The agent and rate are frozen here.
model SchoolPayment {
  id               String             @id @default(auto()) @map("_id") @db.ObjectId
  schoolId         String             @db.ObjectId
  school           School             @relation(fields: [schoolId], references: [id])
  amount           Float
  period           SubscriptionPeriod
  paidAt           DateTime
  note             String?
  salesAgentId     String?            @db.ObjectId
  salesAgent       SalesAgent?        @relation(fields: [salesAgentId], references: [id])
  commissionRate   Float
  commissionAmount Float
  // The school's pack when the payment was recorded (snapshot, no relation). Null on v1 payments.
  packId           String?            @db.ObjectId
  packName         String?
  createdAt        DateTime           @default(now())

  @@index([schoolId, paidAt])
  @@index([salesAgentId, paidAt])
  @@map("school_payments")
}

// A school moving itself to a bigger pack from the student-limit dialog. The new pack applies at once;
// `dueAt` is the payment deadline (null for a school still on trial). `settledAt` is set when the super
// admin records a school payment dated on or after the upgrade. Nothing happens automatically at `dueAt`.
model PackUpgrade {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  schoolId       String    @db.ObjectId
  school         School    @relation(fields: [schoolId], references: [id])
  fromPackId     String?   @db.ObjectId
  fromPackName   String?
  toPackId       String    @db.ObjectId
  toPackName     String
  toMonthlyPrice Float
  byUserId       String    @db.ObjectId
  reason         String
  createdAt      DateTime  @default(now())
  dueAt          DateTime?
  settledAt      DateTime?

  @@index([schoolId, createdAt])
  @@index([settledAt, dueAt])
  @@map("pack_upgrades")
}

// Money paid out to an agent against their commissions.
model AgentPayout {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  salesAgentId String     @db.ObjectId
  salesAgent   SalesAgent @relation(fields: [salesAgentId], references: [id])
  amount       Float
  paidAt       DateTime
  note         String?
  createdAt    DateTime   @default(now())

  @@index([salesAgentId, paidAt])
  @@map("agent_payouts")
}

// The offer shown to visitors coming through a partner's referral link. A single document (key "default"),
// editable by the SUPER_ADMIN. Prices are in MAD.
model PartnerOffer {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  key             String   @unique @default("default")
  active          Boolean  @default(true)
  monthlyPrice    Float
  semiannualPrice Float
  yearlyPrice     Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("partner_offers")
}

model Evaluation {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  branchId    String   @db.ObjectId
  groupId     String   @db.ObjectId
  title       String
  subject     String
  period      String
  date        DateTime
  maxScore    Float    @default(20)
  coefficient Float    @default(1)
  published   Boolean  @default(false)
  notifiedAt  DateTime? // set on the first publish: parents are notified once, never on re-publish
  createdBy   String? // "teacher:<id>" or "user:<id>"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  grades      Grade[]

  @@index([branchId, groupId, period])
  @@map("evaluations")
}

model Grade {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  branchId     String     @db.ObjectId
  evaluationId String     @db.ObjectId
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  studentId    String     @db.ObjectId
  score        Float? // null = not entered yet
  absent       Boolean    @default(false)
  comment      String?
  updatedAt    DateTime   @updatedAt

  @@unique([evaluationId, studentId])
  @@index([studentId])
  @@map("grades")
}

model PushSubscription {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  parentId  String   @db.ObjectId
  branchId  String   @db.ObjectId
  endpoint  String   @unique
  p256dh    String
  auth      String
  lang      String   @default("fr")
  createdAt DateTime @default(now())

  @@index([parentId])
  @@map("push_subscriptions")
}

model WhatsappChannel {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  branchId          String   @unique @db.ObjectId
  instance          String   @unique // "arwa-<branchId>"
  status            String   @default("DISCONNECTED") // DISCONNECTED | CONNECTING | CONNECTED
  phone             String?
  sendAttendance    Boolean  @default(true)
  sendGrades        Boolean  @default(true)
  sendAnnouncements Boolean  @default(false)
  sendActivities    Boolean  @default(true)
  sendHomework      Boolean  @default(true)
  updatedAt         DateTime @updatedAt

  @@map("whatsapp_channels")
}

model OutboundMessage {
  id        String              @id @default(auto()) @map("_id") @db.ObjectId
  branchId  String              @db.ObjectId
  parentId  String              @db.ObjectId
  channel   NotificationChannel
  kind      String // ATTENDANCE | GRADE | ANNOUNCEMENT | TEST
  to        String?
  title     String?
  body      String
  url       String?
  status    String              @default("PENDING") // PENDING | SENDING | SENT | FAILED | SKIPPED
  priority  Int                 @default(5) // 1 = most urgent (ATTENDANCE) … 5 (ANNOUNCEMENT)
  lockedAt  DateTime?
  error     String?
  attempts  Int                 @default(0)
  sendAfter DateTime            @default(now())
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([status, sendAfter])
  @@index([branchId, createdAt])
  @@map("outbound_messages")
}

model Activity {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  branchId     String             @db.ObjectId
  title        String
  description  String?
  startAt      DateTime
  endAt        DateTime?
  location     String?
  price        Float? // null/0 = free
  needsConsent Boolean            @default(true)
  deadline     DateTime? // exact datetime after which parents can no longer answer
  audience     String             @default("ALL") // ALL | GROUPS
  groupIds     String[]           @db.ObjectId
  coverImage   String? // data URL
  published    Boolean            @default(false)
  notifiedAt   DateTime?
  lastRemindedAt DateTime? // staff reminders: at most one per 24 h
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  responses    ActivityResponse[]

  @@index([branchId, startAt])
  @@map("activities")
}

model ActivityResponse {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  activityId String   @db.ObjectId
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  studentId  String   @db.ObjectId
  parentId   String?  @db.ObjectId
  branchId   String   @db.ObjectId
  answer     String? // YES | NO | null (paid before answering)
  paid       Boolean  @default(false)
  note       String?
  answeredAt DateTime @default(now())

  @@unique([activityId, studentId])
  @@map("activity_responses")
}

model Homework {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  branchId  String   @db.ObjectId
  groupId   String   @db.ObjectId
  subject   String
  title     String
  details   String?
  dueDate   DateTime
  createdBy String? // "teacher:<id>" | "user:<id>"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, groupId, dueDate])
  @@map("homeworks")
}

model ParentNotification {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  parentId  String    @db.ObjectId
  branchId  String    @db.ObjectId
  kind      String
  titleFr   String
  titleAr   String
  bodyFr    String
  bodyAr    String
  path      String?
  studentId String?   @db.ObjectId
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([parentId, createdAt])
  @@map("parent_notifications")
}
